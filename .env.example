# ── Copier ce fichier en .env et remplir les valeurs ──────────────────────────
#FLASK_ENV=production
#SECRET_KEY=changez-moi-avec-une-cle-aleatoire-longue

# ── Supabase — CONNECTION POOLER (Transaction mode) ───────────────────────────
# Supabase → Settings → Database → Connection pooling → Transaction → URI
# URL format : postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# ❌ NE PAS utiliser : db.PROJECT_REF.supabase.co:5432  (direct, ne marche pas depuis Windows)
# ✅ UTILISER        : aws-0-XX.pooler.supabase.com:6543 (pooler, toujours accessible)
#
#DATABASE_URL=postgresql://postgres.VOTRE_PROJECT_REF:VOTRE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
